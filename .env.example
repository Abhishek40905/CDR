# Local static build configuration. Vercel uses its own environment variables.
PORT=3000
NODE_ENV=production

# These two public values are written into public/config.js by npm run build.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Legacy Express server only. Hosted admin operations run in Supabase Edge Functions,
# which receive their secret key from Supabase. Never set this variable on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Express server only. Set the hosted AI key in Supabase Edge Function secrets.
ANTHROPIC_API_KEY=

# Legacy Express server setting; Vercel frontend always shows registration.
ALLOW_PUBLIC_SIGNUP=true
# Legacy Express server only.
CORS_ORIGIN=
